#!/bin/sh
# What runs before a commit: the two gates cheap enough to run every time.
#
# `cargo xtask test` is the whole gate (fmt, clippy, layout, docs, tests, the ABI smoke tests, the bridge
# contract) and takes minutes; these two catch the two mistakes that are most annoying to find later - a file
# that is not formatted, and a file that has outgrown the layout rule. Enable this once with:
#
#   git config core.hooksPath .githooks
#
# A gate that is worth having is a gate that runs by itself; the rest is `/loop` or `cargo xtask test`.

set -e

echo "== cargo xtask fmt"
cargo xtask fmt

echo "== cargo xtask layout --check"
cargo xtask layout --check