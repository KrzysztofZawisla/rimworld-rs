<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName Condition="'$(AssemblyName)' == ''">RimWorldRustBridge</AssemblyName>
    <RootNamespace>RustBridge</RootNamespace>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <DebugType>none</DebugType>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <NoWarn>$(NoWarn);CS1701;CS1702;MSB3277;MSB3246;MSB3247</NoWarn>

    <!-- Analyzer coverage at the SDK's recommended level; compiler warnings are errors, analyzer findings
         follow their .editorconfig severities (the `dotnet format` gate looks at those). NuGet restores
         exactly the committed packages.lock.json. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <CodeAnalysisTreatWarningsAsErrors>false</CodeAnalysisTreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode>true</RestoreLockedMode>

    <!-- The game runs on .NET 10 (a WaylithCLR fork) while a local SDK may be 9.x, so the bridge is
         compiled directly against the game's own assemblies. Those assemblies are never stored in
         this repository: either `cargo xtask setup` copied them into the gitignored game-refs/
         folder, or the caller passes -p:RimWorldDir=<game folder> (cargo xtask does that for you). -->
    <!-- Both of these are what keeps a *build* from mixing the SDK's framework assemblies into the
         game's own (that produces CS1705). `dotnet format` needs a framework reference to build a
         compilation for its analyzer stages: without one it prints "Required references were not
         loaded for project ...", exits 0, and checks nothing but whitespace. RimWorldAnalysisPass=1
         re-enables them for that pass alone; `cargo xtask lint` sets it. -->
    <DisableImplicitFrameworkReferences Condition="'$(RimWorldAnalysisPass)' != '1'">true</DisableImplicitFrameworkReferences>
    <NoStdLib Condition="'$(RimWorldAnalysisPass)' != '1'">true</NoStdLib>
    <GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>

    <RimWorldDir Condition="'$(RimWorldDir)' == '' AND Exists('$(MSBuildThisFileDirectory)..\game-refs\Assembly-CSharp.dll')">$(MSBuildThisFileDirectory)..\game-refs</RimWorldDir>
  </PropertyGroup>

  <Target Name="ValidateRimWorldReferences" BeforeTargets="BeforeCompile">
    <Error Condition="'$(RimWorldDir)' == ''"
           Text="RimWorld reference assemblies were not found. Run `cargo xtask setup` to copy them into game-refs/, or build with -p:RimWorldDir=&lt;game folder&gt;." />
    <Error Condition="'$(RimWorldDir)' != '' AND !Exists('$(RimWorldDir)\Assembly-CSharp.dll')"
           Text="'$(RimWorldDir)' does not contain Assembly-CSharp.dll; point RimWorldDir at the RimWorld installation folder (or re-run `cargo xtask setup`)." />
  </Target>

  <!-- Every mod's bridge assembly gets its own copies of the types the XML and the save file name, because two
       Rust mods both ship a bridge and the game resolves a name across *every* loaded assembly, by load order:
       - mod settings are keyed by class name in the config file, so a shared `RustModSettings` makes
         the game resolve it to the wrong assembly and fail with "RustModSettings cannot be cast to
         RustModSettings" while a save loads;
       - a shared comp class silently hands the component to whichever bridge loaded first, so the
         other mod's Rust never sees comp_spawned/comp_tick and nothing is logged;
       - the save file records the game and map components by class name, so a shared name would resolve
         another mod's component when a save loads - which is why the two save-owning components are
         generated per mod here and their hand-written bases stay abstract.
       The generated names carry the mod's own name, `RustSettingsFactory` and `RustPerModComponents` are what
       the hand-written bridge calls, and `cargo xtask test` rejects a patch file that names the shared class
       and a concrete save-facing component declared in bridge/src. -->
  <Target Name="WritePerModTypes" BeforeTargets="BeforeCompile;CoreCompile">
    <PropertyGroup>
      <RustSettingsSuffix>$([System.String]::Copy('$(AssemblyName)').Replace('.', '_').Replace('-', '_'))</RustSettingsSuffix>
      <RustModSuffix>$([System.String]::Copy('$(AssemblyName)').Replace('RimWorldRustBridge.', ''))</RustModSuffix>
      <RustPerModFile>$(IntermediateOutputPath)RustPerModTypes.g.cs</RustPerModFile>
    </PropertyGroup>
    <ItemGroup>
      <RustSettingsLines Include="// &lt;auto-generated by RimWorld.Rust.Bridge.csproj /&gt;" />
      <RustSettingsLines Include="using Verse%3B" />
      <RustSettingsLines Include="namespace RustBridge" />
      <RustSettingsLines Include="{" />
      <RustSettingsLines Include="    /// &lt;summary&gt;The settings of this mod (the name is unique per mod on purpose).&lt;/summary&gt;" />
      <RustSettingsLines Include="    public sealed class RustModSettings_$(RustSettingsSuffix) : RustModSettings" />
      <RustSettingsLines Include="    {" />
      <RustSettingsLines Include="    }" />
      <RustSettingsLines Include="    /// &lt;summary&gt;Creates this mod's settings class through the game's Mod.GetSettings.&lt;/summary&gt;" />
      <RustSettingsLines Include="    internal static class RustSettingsFactory" />
      <RustSettingsLines Include="    {" />
      <RustSettingsLines Include="        public static ModSettings Create(Mod mod)" />
      <RustSettingsLines Include="        {" />
      <RustSettingsLines Include="            RustSettingsMigration.RenameLegacySettings(mod, typeof(RustModSettings_$(RustSettingsSuffix)))%3B" />
      <RustSettingsLines Include="            return mod.GetSettings&lt;RustModSettings_$(RustSettingsSuffix)&gt;()%3B" />
      <RustSettingsLines Include="        }" />
      <RustSettingsLines Include="    }" />
      <RustSettingsLines Include="    /// &lt;summary&gt;The XML-facing thing comp of this mod: a def names THIS class, never the shared base.&lt;/summary&gt;" />
      <RustSettingsLines Include="    public sealed class RustThingCompProperties_$(RustModSuffix) : RustThingCompProperties" />
      <RustSettingsLines Include="    {" />
      <RustSettingsLines Include="    }" />
      <RustSettingsLines Include="    /// &lt;summary&gt;The XML-facing gizmo comp of this mod.&lt;/summary&gt;" />
      <RustSettingsLines Include="    public sealed class RustGizmoCompProperties_$(RustModSuffix) : RustGizmoCompProperties" />
      <RustSettingsLines Include="    {" />
      <RustSettingsLines Include="    }" />
      <RustSettingsLines Include="    /// &lt;summary&gt;This mod's game component: the save file names THIS class, never the shared base.&lt;/summary&gt;" />
      <RustSettingsLines Include="    public sealed class RustGameComponent_$(RustModSuffix) : RustGameComponent" />
      <RustSettingsLines Include="    {" />
      <RustSettingsLines Include="        public RustGameComponent_$(RustModSuffix)(Game game) : base(game) { }" />
      <RustSettingsLines Include="    }" />
      <RustSettingsLines Include="    /// &lt;summary&gt;This mod's map component, named by the save the same way.&lt;/summary&gt;" />
      <RustSettingsLines Include="    public sealed class RustMapComponent_$(RustModSuffix) : RustMapComponent" />
      <RustSettingsLines Include="    {" />
      <RustSettingsLines Include="        public RustMapComponent_$(RustModSuffix)(Map map) : base(map) { }" />
      <RustSettingsLines Include="    }" />
      <RustSettingsLines Include="    /// &lt;summary&gt;How the hand-written bridge reaches this mod's own components: it cannot name a per-mod class.&lt;/summary&gt;" />
      <RustSettingsLines Include="    internal static class RustPerModComponents" />
      <RustSettingsLines Include="    {" />
      <RustSettingsLines Include="        public static RustGameComponent ForGame(Game game)" />
      <RustSettingsLines Include="        {" />
      <RustSettingsLines Include="            return game%3F.GetComponent&lt;RustGameComponent_$(RustModSuffix)&gt;()%3B" />
      <RustSettingsLines Include="        }" />
      <RustSettingsLines Include="        public static RustMapComponent ForMap(Map map)" />
      <RustSettingsLines Include="        {" />
      <RustSettingsLines Include="            return map%3F.GetComponent&lt;RustMapComponent_$(RustModSuffix)&gt;()%3B" />
      <RustSettingsLines Include="        }" />
      <RustSettingsLines Include="    }" />
      <RustSettingsLines Include="}" />
    </ItemGroup>
    <WriteLinesToFile File="$(RustPerModFile)" Lines="@(RustSettingsLines)" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <ItemGroup>
      <Compile Include="$(RustPerModFile)" />
    </ItemGroup>
  </Target>

  <ItemDefinitionGroup Condition="'$(RimWorldDir)' != ''">
    <!-- The game PROVIDES these assemblies at runtime; a mod must never ship its own copies. -->
    <Reference>
      <Private>false</Private>
      <SpecificVersion>false</SpecificVersion>
    </Reference>
  </ItemDefinitionGroup>

  <ItemGroup>
    <!-- Single source of truth for every game def name the bridge looks up. The def names check
         in `cargo xtask test` verifies it against the installed game's XML defs. -->
    <EmbeddedResource Include="names.json">
      <LogicalName>RustBridge.GameNames.json</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup Condition="'$(RimWorldDir)' != ''">
    <Reference Include="$(RimWorldDir)\System.Private.CoreLib.dll" />
    <Reference Include="$(RimWorldDir)\System.Runtime.dll" />
    <Reference Include="$(RimWorldDir)\System.Runtime.Extensions.dll" />
    <Reference Include="$(RimWorldDir)\System.Collections.dll" />
    <Reference Include="$(RimWorldDir)\System.Collections.Concurrent.dll" />
    <Reference Include="$(RimWorldDir)\System.Linq.dll" />
    <Reference Include="$(RimWorldDir)\System.Memory.dll" />
    <Reference Include="$(RimWorldDir)\System.Text.Json.dll" />
    <Reference Include="$(RimWorldDir)\System.Threading.dll" />
    <Reference Include="$(RimWorldDir)\System.Threading.Thread.dll" />
    <Reference Include="$(RimWorldDir)\System.Globalization.dll" />
    <Reference Include="$(RimWorldDir)\System.Reflection.dll" />
    <Reference Include="$(RimWorldDir)\System.Reflection.Primitives.dll" />
    <Reference Include="$(RimWorldDir)\System.Reflection.Emit.dll" />
    <Reference Include="$(RimWorldDir)\System.Reflection.Emit.ILGeneration.dll" />
    <Reference Include="$(RimWorldDir)\System.Reflection.Emit.Lightweight.dll" />
    <Reference Include="$(RimWorldDir)\System.Runtime.InteropServices.dll" />
    <Reference Include="$(RimWorldDir)\System.IO.FileSystem.dll" />
    <Reference Include="$(RimWorldDir)\Assembly-CSharp.dll" />
    <Reference Include="$(RimWorldDir)\UnityStubs.dll" />
  </ItemGroup>

  <ItemGroup>
    <!-- The C# analyzer set this project follows. Analyzers ship with the build only (never loaded by the
         game), and their findings are severities from .editorconfig, so a build never fails on style. -->
    <PackageReference Include="Roslynator.Analyzers" Version="4.12.9" PrivateAssets="all" />
  </ItemGroup>
</Project>
